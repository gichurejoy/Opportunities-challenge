# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: SQLite connection string by default, or MySQL connection string for live DB
# SQLite example: "file:./dev.db"
# MySQL example: "mysql://username:password@localhost:3306/opportunities_db"
DATABASE_URL="file:./dev.db"

# JWT_SECRET: Secret key for signing authorization tokens
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# VITE_GOOGLE_CLIENT_ID: Optional Google Client ID for Google Auth
VITE_GOOGLE_CLIENT_ID=""
